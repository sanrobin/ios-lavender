+#define SDHC_BLOCK_SIZE     0x04
+#define SDHC_BLOCK_COUNT    0x06
+#define SDHC_ARGUMENT       0x08
+#define SDHC_TRANSFER_MODE  0x0c
+#define SDHC_COMMAND        0x0e
+#define SDHC_PRESENT_STATE  0x24
+#define SDHC_HOST_CONTROL_1 0x28
+#define SDHC_INT_STATUS     0x30
+#define SDHC_HOST_CONTROL_2 0x3e
+#define SDHC_CAPABILITIES   0x40
+#define SDHC_ADMA_ADDR      0x58
+
+struct adma2_desc {
+	uint16_t cmd;
+	uint16_t len;
+	uint32_t addr_lo;
+	uint32_t addr_hi;
+	uint32_t reserved;
+} __attribute__((packed, aligned(8)));
+
+static inline uint32_t sdhc_rd(uint32_t off) {
+	return *(volatile uint32_t *)(su.regs + off);
+}
+static inline void sdhc_wr(uint32_t off, uint32_t v) {
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+static inline void sdhc_wr16(uint32_t off, uint16_t v) {
+	*(volatile uint16_t *)(su.regs + off) = v;
+}
+
+static int
+emmc_read_chunk(uint64_t lba, uint32_t count)
+{
+	struct adma2_desc *desc = (struct adma2_desc *)(su.dma + DMA_UTRL);
+	uint64_t desc_pa = su.dma_pa + DMA_UTRL;
+	uint64_t bounce_pa = su.dma_pa + DMA_BOUNCE;
+	uint32_t bytes = count * 512;
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(100ull * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (sdhc_rd(SDHC_PRESENT_STATE) & 3) {
+		if (mach_absolute_time() > deadline) {
+			kprintf("LAVENDER eMMC: command inhibit timeout pstate=0x%x\n", sdhc_rd(SDHC_PRESENT_STATE));
+			return ETIMEDOUT;
+		}
+	}
+
+	uint32_t hctl = sdhc_rd(SDHC_HOST_CONTROL_1);
+	hctl = (hctl & ~0x18) | 0x18;
+	sdhc_wr(SDHC_HOST_CONTROL_1, hctl);
+
+	memset(desc, 0, sizeof(*desc));
+	desc->cmd = 0x0023;
+	desc->len = (uint16_t)bytes;
+	desc->addr_lo = (uint32_t)bounce_pa;
+	desc->addr_hi = (uint32_t)(bounce_pa >> 32);
+
+	dma_clean(DMA_UTRL, sizeof(*desc));
+	dma_sync(DMA_BOUNCE, bytes);
+	__builtin_arm_dsb(0xf);
+
+	sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+	sdhc_wr(SDHC_ADMA_ADDR, (uint32_t)desc_pa);
+	sdhc_wr(SDHC_ADMA_ADDR + 4, (uint32_t)(desc_pa >> 32));
+	sdhc_wr16(SDHC_BLOCK_SIZE, 512);
+	sdhc_wr16(SDHC_BLOCK_COUNT, (uint16_t)count);
+	sdhc_wr(SDHC_ARGUMENT, (uint32_t)lba);
+
+	if (count == 1) {
+		sdhc_wr16(SDHC_TRANSFER_MODE, 0x0011);
+		sdhc_wr16(SDHC_COMMAND, (17 << 8) | 0x3a);
+	} else {
+		sdhc_wr16(SDHC_TRANSFER_MODE, 0x0037);
+		sdhc_wr16(SDHC_COMMAND, (18 << 8) | 0x3a);
+	}
+
+	nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	uint32_t istat = 0;
+	while (1) {
+		istat = sdhc_rd(SDHC_INT_STATUS);
+		if (istat & 2) {
+			break;
+		}
+		if (istat & 0x8000) {
+			sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+			kprintf("LAVENDER eMMC: read error istat 0x%08x LBA 0x%llx count %u pstate 0x%08x\n",
+				istat, lba, count, sdhc_rd(SDHC_PRESENT_STATE));
+			return EIO;
+		}
+		if (mach_absolute_time() > deadline) {
+			sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+			kprintf("LAVENDER eMMC: read timeout LBA 0x%llx count %u istat 0x%x pstate 0x%x\n",
+				lba, count, istat, sdhc_rd(SDHC_PRESENT_STATE));
+			return ETIMEDOUT;
+		}
+	}
+	sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+	dma_sync(DMA_BOUNCE, bytes);
+	return 0;
+}
+
+static int
+emmc_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count == 0 || count * 512 > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	for (uint32_t done = 0; done < count;) {
+		uint32_t chunk = MIN(count - done, 64);
+		int error = emmc_read_chunk(lba + done, chunk);
+		if (error) {
+			return error;
+		}
+		done += chunk;
+	}
+	return 0;
+}
+
+static int
+emmc_write_chunk(uint64_t lba, uint32_t count)
+{
+	struct adma2_desc *desc = (struct adma2_desc *)(su.dma + DMA_UTRL);
+	uint64_t desc_pa = su.dma_pa + DMA_UTRL;
+	uint64_t bounce_pa = su.dma_pa + DMA_BOUNCE;
+	uint32_t bytes = count * 512;
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(100ull * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (sdhc_rd(SDHC_PRESENT_STATE) & 3) {
+		if (mach_absolute_time() > deadline) {
+			kprintf("LAVENDER eMMC: write inhibit timeout pstate=0x%x\n", sdhc_rd(SDHC_PRESENT_STATE));
+			return ETIMEDOUT;
+		}
+	}
+
+	uint32_t hctl = sdhc_rd(SDHC_HOST_CONTROL_1);
+	hctl = (hctl & ~0x18) | 0x18;
+	sdhc_wr(SDHC_HOST_CONTROL_1, hctl);
+
+	memset(desc, 0, sizeof(*desc));
+	desc->cmd = 0x0023;
+	desc->len = (uint16_t)bytes;
+	desc->addr_lo = (uint32_t)bounce_pa;
+	desc->addr_hi = (uint32_t)(bounce_pa >> 32);
+
+	dma_clean(DMA_UTRL, sizeof(*desc));
+	dma_clean(DMA_BOUNCE, bytes);
+	__builtin_arm_dsb(0xf);
+
+	sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+	sdhc_wr(SDHC_ADMA_ADDR, (uint32_t)desc_pa);
+	sdhc_wr(SDHC_ADMA_ADDR + 4, (uint32_t)(desc_pa >> 32));
+	sdhc_wr16(SDHC_BLOCK_SIZE, 512);
+	sdhc_wr16(SDHC_BLOCK_COUNT, (uint16_t)count);
+	sdhc_wr(SDHC_ARGUMENT, (uint32_t)lba);
+
+	if (count == 1) {
+		sdhc_wr16(SDHC_TRANSFER_MODE, 0x0001);
+		sdhc_wr16(SDHC_COMMAND, (24 << 8) | 0x3a);
+	} else {
+		sdhc_wr16(SDHC_TRANSFER_MODE, 0x0027);
+		sdhc_wr16(SDHC_COMMAND, (25 << 8) | 0x3a);
+	}
+
+	nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	uint32_t istat = 0;
+	while (1) {
+		istat = sdhc_rd(SDHC_INT_STATUS);
+		if (istat & 2) {
+			break;
+		}
+		if (istat & 0x8000) {
+			sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+			kprintf("LAVENDER eMMC: write error istat 0x%08x LBA 0x%llx count %u pstate 0x%08x\n",
+				istat, lba, count, sdhc_rd(SDHC_PRESENT_STATE));
+			return EIO;
+		}
+		if (mach_absolute_time() > deadline) {
+			sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+			kprintf("LAVENDER eMMC: write timeout LBA 0x%llx count %u istat 0x%x pstate 0x%x\n",
+				lba, count, istat, sdhc_rd(SDHC_PRESENT_STATE));
+			return ETIMEDOUT;
+		}
+	}
+	sdhc_wr(SDHC_INT_STATUS, 0xffffffff);
+	return 0;
+}
+
+static int
+emmc_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count * 512 > BOUNCE_SIZE ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+		kprintf("LAVENDER eMMC: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	for (uint32_t done = 0; done < count;) {
+		uint32_t chunk = MIN(count - done, 64);
+		int error = emmc_write_chunk(lba + done, chunk);
+		if (error) {
+			return error;
+		}
+		done += chunk;
+	}
+	return 0;
+}
+
+static inline int dev_read_blocks(uint64_t lba, uint32_t count)
+{
+	return su.is_emmc ? emmc_read_blocks(lba, count) : ufs_read_blocks(lba, count);
+}
+
+static inline int dev_write_blocks(uint64_t lba, uint32_t count)
+{
+	return su.is_emmc ? emmc_write_blocks(lba, count) : ufs_write_blocks(lba, count);
+}
+
+static inline int dev_sync_cache(void)
+{
+	return su.is_emmc ? 0 : ufs_sync_cache();
+}
