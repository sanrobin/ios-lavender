diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 44b54c5..0a1a473 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -975,6 +975,18 @@ sweet_cpu_signal_is_enabled(unsigned int cpu)
 	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
 	return cdp != NULL && !(os_atomic_load(&cdp->cpu_signal, acquire) & SIGPdisabled);
 }
+
+void sweet_cpu_signal_enable(unsigned int cpu);
+void
+sweet_cpu_signal_enable(unsigned int cpu)
+{
+	if (cpu < MAX_CPUS) {
+		cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+		if (cdp != NULL) {
+			os_atomic_and(&cdp->cpu_signal, ~SIGPdisabled, release);
+		}
+	}
+}
 #endif
 
 
