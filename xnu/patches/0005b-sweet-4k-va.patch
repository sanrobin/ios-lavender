diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -412,4 +412,8 @@
 
 SECURITY_READ_ONLY_LATE(tt_entry_t *) cpu_tte  = 0;                     /* set by arm_vm_init() - keep out of bss */
 SECURITY_READ_ONLY_LATE(pmap_paddr_t) cpu_ttep = 0;                     /* set by arm_vm_init() - phys tte addr */
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_SWEET)
+SECURITY_READ_ONLY_LATE(tt_entry_t *) cpu_l0_tte  = 0;
+SECURITY_READ_ONLY_LATE(pmap_paddr_t) cpu_l0_ttep = 0;
+#endif
 
@@ -2128,5 +2132,10 @@
 #if HAS_APPLE_PAC
 	kernel_pmap->disable_jop = 0;
 #endif /* HAS_APPLE_PAC */
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_SWEET)
+	kernel_pmap->tte = cpu_l0_tte;
+	kernel_pmap->ttep = cpu_l0_ttep;
+#else
 	kernel_pmap->tte = cpu_tte;
 	kernel_pmap->ttep = cpu_ttep;
+#endif
@@ -10985,7 +10994,9 @@ static_assert((_COMM_PAGE32_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK) >= VM_MAX_ADDRESS
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
  * above the maximum userspace VA.
  */
+#if !defined(SWEET) && !defined(ARM64_BOARD_CONFIG_SWEET)
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -133,7 +133,9 @@ extern int PAGE_SHIFT_CONST;
 
 /* system-wide values */
 #define MACH_VM_MIN_ADDRESS_RAW 0x0ULL
-#if defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_SWEET)
+#define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
+#elif defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
 #else
 #define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
@@ -207,4 +209,8 @@
 #define VM_MIN_KERNEL_ADDRESS   ((vm_address_t) (0ULL - TiB(2)))
 
 // 1.25TB for static_memory_region, 512GB for kernel heap, 256GB for KASAN
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_SWEET)
+#define VM_MAX_KERNEL_ADDRESS   ((vm_address_t) (VM_MIN_KERNEL_ADDRESS + GiB(506) - 1))
+#else
 #define VM_MAX_KERNEL_ADDRESS   ((vm_address_t) (VM_MIN_KERNEL_ADDRESS + GiB(64) + GiB(512) - 1))
+#endif
